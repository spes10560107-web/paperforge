    classDef startend fill:#d1f2d1,stroke:#1a7f37,color:#1f2328

    class P1A,P1B,P1C,P1D phase1
    class P2A,P2B,P2C,P2D phase2
    class P3A,P3B,P3C phase3
    class Start,Done startend
